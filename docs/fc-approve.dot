digraph approve {
    rankdir=TB
    graph [fontname="SimSun", fontsize=14, nodesep=0.6, ranksep=0.75, pad="0.3", splines=ortho]
    node [fontname="SimSun", fontsize=14, style=filled, fillcolor=white]
    edge [fontname="SimSun", fontsize=14]

    start    [label="开始", shape=oval, width=1.4]
    fetch    [label="获取并查看待处理任务", shape=box, width=3.2]
    d_dele   [label="是否选择委派/转办?", shape=diamond, width=3.2, height=1.0]
    delegate [label="执行委派或转办操作", shape=box, width=3.0]
    opinion  [label="填写审批意见", shape=box, width=2.8]
    d_pass   [label="是否审批通过?", shape=diamond, width=2.8, height=1.0]
    complete [label="完成任务并更新审批状态", shape=box, width=3.4]
    end_     [label="结束", shape=oval, width=1.4]

    start    -> fetch -> d_dele
    d_dele   -> delegate [label="是", tailport=e]
    d_dele   -> opinion  [label="否", tailport=s]
    opinion  -> d_pass
    d_pass   -> complete [label="通过", tailport=s]
    d_pass   -> complete [label="拒绝", tailport=e]
    delegate -> end_
    complete -> end_
}
