digraph workflow_mgmt {
    rankdir=TB
    graph [fontname="SimSun", fontsize=14, nodesep=0.6, ranksep=0.75, pad="0.3", splines=ortho]
    node [fontname="SimSun", fontsize=14, style=filled, fillcolor=white]
    edge [fontname="SimSun", fontsize=14]

    start   [label="开始", shape=oval, width=1.4]
    def     [label="创建工作流定义", shape=box, width=3.0]
    design  [label="BPMN编辑器设计流程\n并配置各节点审批规则", shape=box, width=3.6]
    submit  [label="提交发布新版本", shape=box, width=3.0]
    d_valid [label="BPMN结构是否合法?", shape=diamond, width=3.2, height=1.0]
    err     [label="返回校验错误信息", shape=box, width=3.0]
    deploy  [label="部署到Flowable并更新版本记录", shape=box, width=3.6]
    end_    [label="结束", shape=oval, width=1.4]

    start   -> def -> design -> submit -> d_valid
    d_valid -> err    [label="否", tailport=e]
    d_valid -> deploy [label="是", tailport=s]
    err    -> end_
    deploy -> end_
}
