digraph submit {
    rankdir=TB
    graph [fontname="SimSun", fontsize=14, nodesep=0.6, ranksep=0.75, pad="0.3", splines=ortho]
    node [fontname="SimSun", fontsize=14, style=filled, fillcolor=white]
    edge [fontname="SimSun", fontsize=14]

    start   [label="开始", shape=oval, width=1.4]
    fill    [label="选择模板并填写表单", shape=box, width=3.0]
    d_auth  [label="是否具备发起权限?", shape=diamond, width=3.0, height=1.0]
    err     [label="返回权限不足错误", shape=box, width=2.8]
    resolve [label="创建表单实例并解析审批人", shape=box, width=3.4]
    d_sing  [label="是否单人审批?", shape=diamond, width=2.8, height=1.0]
    start_p [label="启动流程实例并写入业务表", shape=box, width=3.4]
    end_    [label="结束", shape=oval, width=1.4]

    start   -> fill -> d_auth
    d_auth  -> err     [label="否", tailport=e]
    d_auth  -> resolve [label="是", tailport=s]
    resolve -> d_sing
    d_sing  -> start_p [label="单人审批流", tailport=s]
    d_sing  -> start_p [label="顺序审批流", tailport=e]
    err     -> end_
    start_p -> end_
}
